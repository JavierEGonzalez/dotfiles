{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".scratch/AGENTS.md",
    ".github/copilot-instructions.md"
  ],
  "plugin": [
    "@plannotator/opencode@latest"
  ],
  "permission": {
    "external_directory": {
      "~/.scratch/**": "allow",
      "/tmp/**": "allow",
      "~/workspace/**": "allow"
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "options": {},
      "permission": {}
    },
    "general": {
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-5",
      "options": {},
      "permission": {}
    },
    "explore": {
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "options": {},
      "permission": {}
    },
    "scout": {
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "options": {},
      "permission": {}
    },
    "single-task-worker": {
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-5",
      "options": {},
      "permission": {}
    },
    "orchestrator": {
      "model": "github-copilot/claude-opus-5",
      "options": {},
      "permission": {}
    },
    "lint-fixer": {
      "model": "github-copilot/claude-haiku-4.5",
      "options": {},
      "permission": {}
    },
    "task-orchestrator": {
      "model": "github-copilot/claude-opus-5",
      "options": {},
      "permission": {}
    },
    "micro-task-runner": {
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "options": {},
      "permission": {}
    }
  },
  "skills": {
    "paths": [
      "~/.agents/skills",
      "~/workspace/prism3/.agents/skills"
    ]
  },
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "code-review-graph",
        "mcp"
      ],
      "enabled": true
    }
  },
  "shell": "zsh"
}
